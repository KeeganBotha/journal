DATABASE_URL=
# optional: non-pooled connection for migrations (falls back to DATABASE_URL)
DIRECT_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# web push — generate once with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address for VAPID
VAPID_SUBJECT=
# shared secret Vercel sends to /api/cron/reminders
CRON_SECRET=
# IANA name, e.g. Africa/Johannesburg — every "today" in the app uses it
APP_TIMEZONE=
